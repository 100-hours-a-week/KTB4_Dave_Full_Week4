# Replace this value with the exact upstream MySQL patch version used by RDS.
MYSQL_VERSION=REPLACE_WITH_RDS_VERSION

MYSQL_DATABASE=community_perf
MYSQL_USER=community_perf
MYSQL_PASSWORD=load-test-db-password
MYSQL_ROOT_PASSWORD=load-test-root-password

# At least 32 bytes. This value is only for the disposable local environment.
JWT_SECRET=local-load-test-jwt-secret-at-least-32-bytes-long
LOAD_TEST_USER_PASSWORD=Loadtest1!

APP_PORT=8080

# lifecycle.ps1 overrides this value from -Variant during A/B/C runs.
POPULAR_POST_CACHE_ENABLED=true
